{
  // This file is JSONC: fallow reads comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "core/server.ts",
    "web/src/main.ts",
    "**/server.{ts,js,mjs}",
    "**/src/main.{ts,tsx,js,jsx,mjs}"
  ],
  // site/ is a standalone Astro app (own package.json + build); fallow can't parse
  // .astro files, so it false-flags site/src/lib exports and site's fontsource deps.
  "ignorePatterns": [
    "site/**"
  ],
  "workspaces": {
    "patterns": [
      "core",
      "web"
    ]
  },
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {}
}
