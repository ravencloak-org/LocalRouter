// LocalRouter Dashboard (Tailwind). Ripple 0.3.x: component = `function` returning a single
// JSX root; reactive `@x = v` writes don't work in nested async, so the header pills + inputs
// are updated imperatively (plain DOM). The event feed uses reactive RippleArray + @for.
// Badge/pill class strings are written as literals so Tailwind's scanner includes them.
import { RippleArray } from "ripple";
import type { LrEvent } from "../../shared/events";
import {
  getStatus, setConfig, login, getRequest,
  listTokens, createToken, revokeToken, getUsage,
  type Model, type Effort, type Token, type ClientUsage,
} from "./control";

function summary(ev: LrEvent): string {
  if (ev.kind === "request")
    return `${ev.phase}${ev.latencyMs ? ` · ${ev.latencyMs}ms` : ""}${ev.errorType ? ` · ${ev.errorType}` : ""}`;
  if (ev.kind === "log") return `[${ev.level}] ${ev.msg}`;
  if (ev.kind === "span") return `${ev.name} · ${ev.durationMs}ms`;
  return ev.delta; // token
}

function badge(kind: string): string {
  const base = "inline-block px-2 py-0.5 rounded-md text-xs font-medium ";
  if (kind === "request") return base + "bg-sky-500/15 text-sky-300";
  if (kind === "log") return base + "bg-red-500/15 text-red-300";
  if (kind === "span") return base + "bg-emerald-500/15 text-emerald-300";
  return base + "bg-neutral-700/40 text-neutral-400"; // token
}

function reqCount(evs: RippleArray<LrEvent>): number {
  let n = 0;
  for (const e of evs) if (e.kind === "request" && e.phase === "done") n++;
  return n;
}
function tokCount(evs: RippleArray<LrEvent>): number {
  let n = 0;
  for (const e of evs) if (e.kind === "request" && e.completionTokens) n += e.completionTokens;
  return n;
}
function costSum(evs: RippleArray<LrEvent>): string {
  let c = 0;
  for (const e of evs) if (e.kind === "request" && e.phase === "done" && e.costUsd) c += e.costUsd;
  return "$" + c.toFixed(4);
}

export function App() {
  async function refresh() {
    let s = null;
    try {
      s = await getStatus();
    } catch {
      s = null;
    }
    const run = document.getElementById("lr-run");
    if (run) {
      run.textContent = s ? "● running · :" + s.port : "○ core not reachable";
      run.style.color = s ? "#34d399" : "#737373";
    }
    const lg = document.getElementById("lr-login");
    if (lg) {
      lg.textContent = s ? (s.loggedIn ? "logged in" : "logged out") : "—";
      lg.style.color = s ? (s.loggedIn ? "#34d399" : "#f87171") : "#737373";
    }
    if (s) {
      setVal("lr-model", s.model);
      setVal("lr-effort", s.effort ?? "");
      setVal("lr-port", String(s.port));
      setVal("lr-baseurl", s.anthropicBaseUrl ?? "");
    }
  }
  function setVal(id: string, v: string) {
    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    if (el && document.activeElement !== el) el.value = v;
  }
  refresh();
  setInterval(refresh, 5000);

  const onModel = async (e: Event) => {
    await setConfig({ model: (e.target as HTMLSelectElement).value as Model });
    refresh();
  };
  const onEffort = async (e: Event) => {
    await setConfig({ effort: (e.target as HTMLSelectElement).value as Effort });
    refresh();
  };
  const onPort = async (e: Event) => {
    const v = Number((e.target as HTMLInputElement).value);
    if (v > 0 && v < 65536) {
      await setConfig({ port: v });
      refresh();
    }
  };
  const onBaseUrl = async (e: Event) => {
    await setConfig({ anthropicBaseUrl: (e.target as HTMLInputElement).value.trim() });
    refresh();
  };

  // ngrok-style inspector: click a request row -> full req/resp in a side drawer.
  // Imperative DOM (reactive @-writes don't work in nested async on this Ripple).
  const openDetail = async (id: string) => {
    const drawer = document.getElementById("lr-drawer");
    const meta = document.getElementById("lr-d-meta");
    const req = document.getElementById("lr-d-req");
    const res = document.getElementById("lr-d-res");
    if (!drawer || !meta || !req || !res) return;
    meta.textContent = "loading…";
    req.textContent = "";
    res.textContent = "";
    drawer.style.display = "block";
    try {
      const r = await getRequest(id);
      meta.textContent =
        `${r.model} · ${r.stream ? "stream" : "non-stream"} · HTTP ${r.httpStatus} · ` +
        `${r.promptTokens}+${r.completionTokens} tok · ${r.latencyMs}ms · $${(r.costUsd ?? 0).toFixed(4)}` +
        (r.errorType ? ` · ${r.errorType}` : "");
      req.textContent = JSON.stringify(r.messages, null, 2);
      res.textContent = r.response ?? "";
    } catch {
      meta.textContent = "no record (evicted, or not a chat request)";
    }
  };
  const closeDetail = () => {
    const d = document.getElementById("lr-drawer");
    if (d) d.style.display = "none";
  };

  const events = new RippleArray<LrEvent>();
  const es = new EventSource("/events");
  es.onmessage = (m) => {
    events.push(JSON.parse(m.data) as LrEvent);
    if (events.length > 500) events.shift();
  };

  // --- analytics (per-window tiles imperatively; per-client table reactively) ---
  const clients = new RippleArray<ClientUsage>();
  const refreshUsage = async () => {
    let u;
    try {
      u = await getUsage();
    } catch {
      return;
    }
    const set = (id: string, w: { requests: number; completionTokens: number; costUsd: number }) => {
      const el = document.getElementById(id);
      if (el) el.textContent = `${w.requests} req · ${w.completionTokens} tok · $${w.costUsd.toFixed(4)}`;
    };
    set("u-1h", u.windows["1h"]);
    set("u-24h", u.windows["24h"]);
    set("u-7d", u.windows["7d"]);
    while (clients.length) clients.shift();
    for (const c of u.byClient) clients.push(c);
  };
  refreshUsage();
  setInterval(refreshUsage, 10000);

  // --- client tokens ---
  const tokens = new RippleArray<Token>();
  const loadTokens = async () => {
    const list = await listTokens();
    while (tokens.length) tokens.shift();
    for (const t of list) tokens.push(t);
  };
  loadTokens();
  const onCreateToken = async () => {
    const input = document.getElementById("tok-name") as HTMLInputElement | null;
    const out = document.getElementById("tok-new");
    const name = (input?.value ?? "").trim() || "client";
    const r = await createToken(name);
    if (out) out.textContent = `${r.name}:  ${r.token}`; // paste into the client's api_key
    if (input) input.value = "";
    loadTokens();
  };
  const onRevoke = async (token: string) => {
    await revokeToken(token);
    loadTokens();
  };

  return <div class="min-h-screen bg-neutral-950 text-neutral-300 antialiased">
    <div class="mx-auto max-w-6xl p-6 space-y-6">

      <header class="flex items-center gap-3">
        <img src="/favicon.png" class="h-9 w-9" alt="" />
        <div>
          <h1 class="text-lg font-semibold text-neutral-100 leading-none">{"LocalRouter"}</h1>
          <p class="mt-1 text-xs text-neutral-500">{"Claude subscription → OpenAI-compatible API"}</p>
        </div>
        <div class="ml-auto flex items-center gap-2">
          <span id="lr-run" class="rounded-full border border-neutral-700 bg-neutral-900 px-3 py-1 text-xs font-medium">{"…"}</span>
          <span id="lr-login" class="rounded-full border border-neutral-700 bg-neutral-900 px-3 py-1 text-xs font-medium">{"…"}</span>
        </div>
      </header>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="text-xs uppercase tracking-wide text-neutral-500">{"Requests"}</div>
          <div class="mt-1 text-2xl font-semibold tabular-nums text-neutral-100">{reqCount(events)}</div>
        </div>
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="text-xs uppercase tracking-wide text-neutral-500">{"Output tokens"}</div>
          <div class="mt-1 text-2xl font-semibold tabular-nums text-neutral-100">{tokCount(events)}</div>
        </div>
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="text-xs uppercase tracking-wide text-neutral-500">{"Cost"}</div>
          <div class="mt-1 text-2xl font-semibold tabular-nums text-emerald-400">{costSum(events)}</div>
        </div>
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="text-xs uppercase tracking-wide text-neutral-500">{"Events"}</div>
          <div class="mt-1 text-2xl font-semibold tabular-nums text-neutral-100">{events.length}</div>
        </div>
      </div>

      <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
        <div class="flex flex-wrap items-end gap-4">
          <label class="flex flex-col gap-1">
            <span class="text-xs text-neutral-500">{"Model"}</span>
            <select id="lr-model" onChange={onModel} class="rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-neutral-500">
              <option value="sonnet">{"sonnet"}</option>
              <option value="opus">{"opus"}</option>
              <option value="haiku">{"haiku"}</option>
            </select>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-xs text-neutral-500">{"Effort"}</span>
            <select id="lr-effort" onChange={onEffort} class="rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-neutral-500">
              <option value="">{"default"}</option>
              <option value="low">{"low"}</option>
              <option value="medium">{"medium"}</option>
              <option value="high">{"high"}</option>
            </select>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-xs text-neutral-500">{"Port"}<span class="text-neutral-600">{" (restart)"}</span></span>
            <input id="lr-port" type="number" min="1" max="65535" onChange={onPort} class="w-24 rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-neutral-500" />
          </label>
          <label class="flex flex-1 flex-col gap-1">
            <span class="text-xs text-neutral-500">{"Anthropic base URL"}</span>
            <input id="lr-baseurl" type="text" placeholder="default" onChange={onBaseUrl} class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-neutral-500" />
          </label>
          <button onClick={() => login()} class="rounded-lg bg-neutral-100 px-4 py-1.5 text-sm font-medium text-neutral-900 transition hover:bg-white">{"Login"}</button>
        </div>
        <p class="mt-3 text-xs text-neutral-600">{"Start / Stop the core from the menu-bar tray. Port applies on restart; env vars win over these fields."}</p>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="mb-3 text-xs font-medium uppercase tracking-wide text-neutral-500">{"Usage"}</div>
          <div class="grid grid-cols-3 gap-3">
            <div><div class="text-xs text-neutral-500">{"last hour"}</div><div id="u-1h" class="mt-1 text-xs tabular-nums text-neutral-200">{"…"}</div></div>
            <div><div class="text-xs text-neutral-500">{"last 24h"}</div><div id="u-24h" class="mt-1 text-xs tabular-nums text-neutral-200">{"…"}</div></div>
            <div><div class="text-xs text-neutral-500">{"last 7d"}</div><div id="u-7d" class="mt-1 text-xs tabular-nums text-neutral-200">{"…"}</div></div>
          </div>
          <div class="mt-4 mb-1 text-xs uppercase tracking-wide text-neutral-500">{"By client (7d)"}</div>
          <table class="w-full text-sm">
            <tbody>
              @for (const c of clients) {
                <tr class="border-b border-neutral-800/50">
                  <td class="py-1 pr-4 text-neutral-200">{c.client}</td>
                  <td class="py-1 pr-4 tabular-nums text-neutral-400">{c.requests}{" req"}</td>
                  <td class="py-1 pr-4 tabular-nums text-neutral-400">{c.completionTokens}{" tok"}</td>
                  <td class="py-1 tabular-nums text-emerald-400">{"$"}{c.costUsd.toFixed(4)}</td>
                </tr>
              }
            </tbody>
          </table>
        </div>

        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="mb-3 text-xs font-medium uppercase tracking-wide text-neutral-500">{"Client tokens"}</div>
          <div class="flex flex-wrap items-center gap-2">
            <input id="tok-name" type="text" placeholder="client name (e.g. cognee)" class="rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-neutral-500" />
            <button onClick={() => onCreateToken()} class="rounded-lg bg-neutral-100 px-3 py-1.5 text-sm font-medium text-neutral-900 hover:bg-white">{"Create token"}</button>
          </div>
          <div id="tok-new" class="mt-2 break-all font-mono text-xs text-emerald-400"></div>
          <table class="mt-3 w-full text-sm">
            <tbody>
              @for (const t of tokens) {
                <tr class="border-b border-neutral-800/50">
                  <td class="py-1 pr-4 text-neutral-200">{t.name}</td>
                  <td class="py-1 pr-4 font-mono text-xs text-neutral-500">{t.token}</td>
                  <td class="py-1 text-right"><button onClick={() => onRevoke(t.token)} class="text-red-400 hover:text-red-300">{"revoke"}</button></td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900">
        <div class="border-b border-neutral-800 px-4 py-2.5 text-xs font-medium uppercase tracking-wide text-neutral-500">{"Live requests"}</div>
        <div class="max-h-[26rem] overflow-auto">
          <table class="w-full text-sm">
            <tbody>
              @for (const ev of events) {
                <tr class="cursor-pointer border-b border-neutral-800/50 transition hover:bg-neutral-800/40" onClick={() => { if (ev.kind === "request") openDetail(ev.requestId); }}>
                  <td class="w-24 px-4 py-1.5"><span class={badge(ev.kind)}>{ev.kind}</span></td>
                  <td class="px-4 py-1.5 text-xs text-neutral-400">{("client" in ev && ev.client) || ""}</td>
                  <td class="px-4 py-1.5 font-mono text-xs text-neutral-500">{("requestId" in ev && ev.requestId) || ""}</td>
                  <td class="px-4 py-1.5 text-neutral-300">{summary(ev)}</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>

      <div id="lr-drawer" class="fixed inset-y-0 right-0 z-50 w-[42rem] max-w-full space-y-4 overflow-auto border-l border-neutral-800 bg-neutral-900 p-5 shadow-2xl" style="display:none">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-neutral-100">{"Request detail"}</h2>
          <button onClick={() => closeDetail()} class="text-neutral-500 hover:text-neutral-200">{"✕"}</button>
        </div>
        <div id="lr-d-meta" class="font-mono text-xs text-neutral-400"></div>
        <div>
          <div class="mb-1 text-xs uppercase tracking-wide text-neutral-500">{"Request"}</div>
          <pre id="lr-d-req" class="max-h-72 overflow-auto whitespace-pre-wrap rounded-lg border border-neutral-800 bg-neutral-950 p-3 text-xs text-neutral-300"></pre>
        </div>
        <div>
          <div class="mb-1 text-xs uppercase tracking-wide text-neutral-500">{"Response"}</div>
          <pre id="lr-d-res" class="max-h-96 overflow-auto whitespace-pre-wrap rounded-lg border border-neutral-800 bg-neutral-950 p-3 text-xs text-neutral-300"></pre>
        </div>
      </div>

    </div>
  </div>
}
