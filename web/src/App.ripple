// LocalRouter Dashboard — control bar + live Event feed.
// ponytail: Ripple 0.3.x (TSRX) — a component is a `function` whose body contains JSX (no
// `component` keyword). Reactive `@x = v` writes only work at component-body top level, NOT
// in nested async fns, so the single status line is updated imperatively (plain DOM). The
// event feed uses the proven RippleArray + @for reactive path.
import { RippleArray } from "ripple";
import type { LrEvent } from "../../shared/events";
import { getStatus, setConfig, login, shutdown, type Model, type Effort } from "./control";

function summary(ev: LrEvent): string {
  if (ev.kind === "request")
    return `${ev.phase}${ev.latencyMs ? ` · ${ev.latencyMs}ms` : ""}${ev.errorType ? ` · ${ev.errorType}` : ""}`;
  if (ev.kind === "log") return `[${ev.level}] ${ev.msg}`;
  if (ev.kind === "span") return `${ev.name} · ${ev.durationMs}ms`;
  return ev.delta; // token
}

export function App() {
  // --- control: status line updated imperatively (see header note) ---
  async function refresh() {
    let s = null;
    try {
      s = await getStatus();
    } catch {
      s = null; // core unreachable
    }
    const el = document.getElementById("lr-status");
    if (!el) return;
    el.textContent = s
      ? `● :${s.port} · ${s.model} · effort:${s.effort ?? "—"} · ${s.loggedIn ? "logged in" : "LOGGED OUT"}${s.anthropicBaseUrl ? " · " + s.anthropicBaseUrl : ""}`
      : "○ core not reachable";
    el.className = s && !s.loggedIn ? "stat off" : "stat";
    // reflect current values into inputs (only when the user isn't editing them)
    if (s) {
      const p = document.getElementById("lr-port") as HTMLInputElement | null;
      if (p && document.activeElement !== p) p.value = String(s.port);
      const u = document.getElementById("lr-baseurl") as HTMLInputElement | null;
      if (u && document.activeElement !== u) u.value = s.anthropicBaseUrl ?? "";
    }
  }
  refresh();
  // ponytail: interval never cleared — the dashboard is one long-lived page, so fine.
  setInterval(refresh, 5000);

  const onModel = async (e: Event) => {
    await setConfig({ model: (e.target as HTMLSelectElement).value as Model });
    refresh();
  };
  const onEffort = async (e: Event) => {
    await setConfig({ effort: (e.target as HTMLSelectElement).value as Effort });
    refresh();
  };
  const onPort = async (e: Event) => {
    const v = Number((e.target as HTMLInputElement).value);
    if (v > 0 && v < 65536) {
      await setConfig({ port: v });
      refresh(); // note: applies on core restart
    }
  };
  const onBaseUrl = async (e: Event) => {
    await setConfig({ anthropicBaseUrl: (e.target as HTMLInputElement).value.trim() });
    refresh();
  };

  // --- event feed (reactive) ---
  const events = new RippleArray<LrEvent>();
  const es = new EventSource("/events");
  es.onmessage = (m) => {
    events.push(JSON.parse(m.data) as LrEvent);
    if (events.length > 500) events.shift();
  };

  return <div class="app">
    <h1>{"LocalRouter"}</h1>

    <div class="controls">
      <span id="lr-status" class="stat">{"…"}</span>
      <button onClick={() => login()}>{"Login"}</button>
      <select onChange={onModel}>
        <option value="sonnet">{"sonnet"}</option>
        <option value="opus">{"opus"}</option>
        <option value="haiku">{"haiku"}</option>
      </select>
      <select onChange={onEffort}>
        <option value="low">{"low"}</option>
        <option value="medium">{"medium"}</option>
        <option value="high">{"high"}</option>
      </select>
      <label class="fld">{"port"}<input id="lr-port" type="number" min="1" max="65535" onChange={onPort} title="applies on core restart" /></label>
      <label class="fld">{"anthropic url"}<input id="lr-baseurl" type="text" placeholder="default" onChange={onBaseUrl} title="ANTHROPIC_BASE_URL for the CLI; blank = default" /></label>
      <button onClick={() => shutdown()}>{"Stop"}</button>
    </div>

    <table>
      <tbody>
        @for (const ev of events) {
          <tr class={ev.kind}>
            <td>{ev.kind}</td>
            <td>{("requestId" in ev && ev.requestId) || ""}</td>
            <td>{summary(ev)}</td>
          </tr>
        }
      </tbody>
    </table>

    <style>
    .app { font-family: ui-monospace, SFMono-Regular, monospace; padding: 1rem; color: #ddd; background: #111; min-height: 100vh; }
    h1 { font-size: 1rem; opacity: .6; }
    .controls { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #262626; font-size: 12px; }
    .stat { color: #aaa; }
    .stat.off { color: #e66; font-weight: bold; }
    .controls button, .controls select, .controls input { font: inherit; font-size: 12px; background: #1a1a1a; color: #ddd; border: 1px solid #333; border-radius: 4px; padding: 3px 8px; }
    .controls button, .controls select { cursor: pointer; }
    .controls button:hover, .controls select:hover, .controls input:focus { border-color: #555; }
    .controls .fld { display: flex; gap: 4px; align-items: center; }
    .controls #lr-port { width: 64px; }
    .controls #lr-baseurl { width: 200px; }
    td { padding: 2px 10px; border-bottom: 1px solid #262626; font-size: 12px; }
    tr.request td:first-child { color: #6ad; }
    tr.log td:first-child { color: #e66; }
    tr.span td:first-child { color: #8c8; }
    tr.token td:first-child { color: #999; }
  </style>
  </div>
}
