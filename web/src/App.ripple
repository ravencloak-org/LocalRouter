// LocalRouter Dashboard (Tailwind). Ripple 0.3.x: component = `function` returning a single
// JSX root; reactive `@x = v` writes don't work in nested async, so the header pills + inputs
// are updated imperatively (plain DOM). The event feed uses reactive RippleArray + @for.
// Badge/pill class strings are written as literals so Tailwind's scanner includes them.
import { RippleArray } from "ripple";
import type { LrEvent } from "../../shared/events";
import {
  getStatus, setConfig, login, getRequest,
  listTokens, createToken, revokeToken, getUsage,
  type Model, type Effort, type Token, type ClientUsage,
} from "./control";

// One request = one row (consolidated across queued/spawning/done). Phase-colored dot.
type Row = {
  id: string; client: string; model: string; phase: string; ts: number;
  latencyMs?: number; completionTokens?: number; costUsd?: number; httpStatus?: number; errorType?: string;
  phases: { phase: string; ts: number }[];
};
function phaseColor(phase: string, httpStatus?: number): string {
  if (phase === "error" || (httpStatus != null && httpStatus >= 400)) return "bg-red-500";
  if (phase === "done") return "bg-emerald-500";
  if (phase === "queued") return "bg-slate-400"; // waiting for a semaphore slot — distinct from active
  return "bg-amber-500"; // spawning / streaming = actively running
}
function rowLine(r: Row): string {
  const bits: string[] = [r.phase];
  if (r.latencyMs) bits.push(`${r.latencyMs}ms`);
  if (r.completionTokens) bits.push(`${r.completionTokens}t`);
  if (r.costUsd) bits.push(`$${r.costUsd.toFixed(4)}`);
  if (r.errorType) bits.push(r.errorType);
  if (r.httpStatus && r.httpStatus >= 400) bits.push(String(r.httpStatus));
  return bits.join(" · ");
}

function reqCount(evs: RippleArray<LrEvent>): number {
  let n = 0;
  for (const e of evs) if (e.kind === "request" && e.phase === "done") n++;
  return n;
}
function tokCount(evs: RippleArray<LrEvent>): number {
  let n = 0;
  for (const e of evs) if (e.kind === "request" && e.completionTokens) n += e.completionTokens;
  return n;
}
function costSum(evs: RippleArray<LrEvent>): string {
  let c = 0;
  for (const e of evs) if (e.kind === "request" && e.phase === "done" && e.costUsd) c += e.costUsd;
  return "$" + c.toFixed(4);
}

export function App() {
  async function refresh() {
    let s = null;
    try {
      s = await getStatus();
    } catch {
      s = null;
    }
    const run = document.getElementById("lr-run");
    if (run) {
      run.textContent = s ? "● running · :" + s.port : "○ core not reachable";
      run.style.color = s ? "#34d399" : "#7a625b";
    }
    const lg = document.getElementById("lr-login");
    if (lg) {
      lg.textContent = s ? (s.loggedIn ? "logged in" : "logged out") : "—";
      lg.style.color = s ? (s.loggedIn ? "#34d399" : "#f87171") : "#7a625b";
    }
    if (s) {
      setVal("lr-model", s.model);
      setVal("lr-effort", s.effort ?? "");
      setVal("lr-port", String(s.port));
      setVal("lr-baseurl", s.anthropicBaseUrl ?? "");
    }
  }
  function setVal(id: string, v: string) {
    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    if (el && document.activeElement !== el) el.value = v;
  }
  refresh();
  setInterval(refresh, 5000);

  const onModel = async (e: Event) => {
    await setConfig({ model: (e.target as HTMLSelectElement).value as Model });
    refresh();
  };
  const onEffort = async (e: Event) => {
    await setConfig({ effort: (e.target as HTMLSelectElement).value as Effort });
    refresh();
  };
  const onPort = async (e: Event) => {
    const v = Number((e.target as HTMLInputElement).value);
    if (v > 0 && v < 65536) {
      await setConfig({ port: v });
      refresh();
    }
  };
  const onBaseUrl = async (e: Event) => {
    await setConfig({ anthropicBaseUrl: (e.target as HTMLInputElement).value.trim() });
    refresh();
  };

  // Consolidate: one row per requestId (request events only — logs/tokens excluded).
  const rowMap = new Map<string, Row>();
  const rows = new RippleArray<Row>();
  function syncRows() {
    const arr = [...rowMap.values()].sort((a, b) => b.ts - a.ts).slice(0, 300);
    while (rows.length) rows.shift();
    for (const r of arr) rows.push(r);
  }
  const events = new RippleArray<LrEvent>(); // kept for the top stat tiles
  const es = new EventSource("/events");
  es.onmessage = (m) => {
    const ev = JSON.parse(m.data) as LrEvent;
    if (ev.kind !== "request") return; // logs/tokens/spans are not request rows — skip reactive churn
    events.push(ev); // only request events feed the stat tiles
    if (events.length > 500) events.shift();
    let r = rowMap.get(ev.requestId);
    if (!r) {
      r = { id: ev.requestId, client: ev.client ?? "unknown", model: ev.model, phase: ev.phase, ts: ev.ts, phases: [] };
      rowMap.set(ev.requestId, r);
    }
    r.phase = ev.phase;
    r.ts = ev.ts;
    r.phases.push({ phase: ev.phase, ts: ev.ts });
    if (ev.client && ev.client !== "unknown") r.client = ev.client;
    if (ev.latencyMs != null) r.latencyMs = ev.latencyMs;
    if (ev.completionTokens != null) r.completionTokens = ev.completionTokens;
    if (ev.costUsd != null) r.costUsd = ev.costUsd;
    if (ev.httpStatus != null) r.httpStatus = ev.httpStatus;
    if (ev.errorType) r.errorType = ev.errorType;
    if (rowMap.size > 300) {
      const oldest = [...rowMap.values()].sort((a, b) => a.ts - b.ts)[0];
      if (oldest) rowMap.delete(oldest.id);
    }
    syncRows();
  };

  // master-detail: click a row -> transitions timeline + full req/resp (imperative DOM).
  const selectRow = async (id: string) => {
    const r = rowMap.get(id);
    document.querySelectorAll("[data-row]").forEach((el) => {
      (el as HTMLElement).style.background = (el as HTMLElement).dataset.row === id ? "rgba(255,87,71,0.12)" : "";
    });
    const head = document.getElementById("d-head");
    const meta = document.getElementById("d-meta");
    const tl = document.getElementById("d-timeline");
    const req = document.getElementById("d-req");
    const res = document.getElementById("d-res");
    if (head) head.textContent = id;
    if (meta && r) meta.textContent = `${r.client} · ${r.model} · ${rowLine(r)}`;
    if (tl && r) tl.textContent = r.phases.map((p) => `${p.phase.padEnd(10)} ${new Date(p.ts).toLocaleTimeString()}`).join("\n");
    if (req) req.textContent = "loading…";
    if (res) res.textContent = "";
    try {
      const rec = await getRequest(id);
      if (req) req.textContent = JSON.stringify(rec.messages, null, 2);
      if (res) res.textContent = rec.response ?? "";
    } catch {
      if (req) req.textContent = "no stored body (rejected request or evicted)";
    }
  };

  // --- analytics (per-window tiles imperatively; per-client table reactively) ---
  const clients = new RippleArray<ClientUsage>();
  const refreshUsage = async () => {
    let u;
    try {
      u = await getUsage();
    } catch {
      return;
    }
    const set = (id: string, w: { requests: number; completionTokens: number; costUsd: number }) => {
      const el = document.getElementById(id);
      if (el) el.textContent = `${w.requests} req · ${w.completionTokens} tok · $${w.costUsd.toFixed(4)}`;
    };
    set("u-1h", u.windows["1h"]);
    set("u-24h", u.windows["24h"]);
    set("u-7d", u.windows["7d"]);
    while (clients.length) clients.shift();
    for (const c of u.byClient) clients.push(c);
  };
  refreshUsage();
  setInterval(refreshUsage, 10000);

  // --- client tokens ---
  const tokens = new RippleArray<Token>();
  const loadTokens = async () => {
    const list = await listTokens();
    while (tokens.length) tokens.shift();
    for (const t of list) tokens.push(t);
  };
  loadTokens();
  const onCreateToken = async () => {
    const input = document.getElementById("tok-name") as HTMLInputElement | null;
    const out = document.getElementById("tok-new");
    const name = (input?.value ?? "").trim() || "client";
    const r = await createToken(name);
    if (out) out.textContent = `${r.name}:  ${r.token}`; // paste into the client's api_key
    if (input) input.value = "";
    loadTokens();
  };
  const onRevoke = async (token: string) => {
    await revokeToken(token);
    loadTokens();
  };

  return <div class="min-h-screen overflow-x-hidden bg-neutral-950 text-neutral-300 antialiased">
    <div class="mx-auto max-w-6xl p-6 space-y-6">

      <header class="flex flex-wrap items-center gap-3">
        <img src="/favicon.png" class="h-9 w-9" alt="" />
        <div>
          <h1 class="text-lg font-semibold text-neutral-100 leading-none">{"LocalRouter"}</h1>
          <p class="mt-1 text-xs text-neutral-500">{"Claude subscription → OpenAI-compatible API"}</p>
        </div>
        <div class="ml-auto flex items-center gap-2">
          <span id="lr-run" class="rounded-full border border-neutral-700 bg-neutral-900 px-3 py-1 text-xs font-medium">{"…"}</span>
          <span id="lr-login" class="rounded-full border border-neutral-700 bg-neutral-900 px-3 py-1 text-xs font-medium">{"…"}</span>
        </div>
      </header>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="text-xs uppercase tracking-wide text-neutral-500">{"Requests"}</div>
          <div class="mt-1 text-2xl font-semibold tabular-nums text-neutral-100">{reqCount(events)}</div>
        </div>
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="text-xs uppercase tracking-wide text-neutral-500">{"Output tokens"}</div>
          <div class="mt-1 text-2xl font-semibold tabular-nums text-neutral-100">{tokCount(events)}</div>
        </div>
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="text-xs uppercase tracking-wide text-neutral-500">{"Cost"}</div>
          <div class="mt-1 text-2xl font-semibold tabular-nums text-emerald-400">{costSum(events)}</div>
        </div>
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="text-xs uppercase tracking-wide text-neutral-500">{"Events"}</div>
          <div class="mt-1 text-2xl font-semibold tabular-nums text-neutral-100">{events.length}</div>
        </div>
      </div>

      <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
        <div class="flex flex-wrap items-end gap-4">
          <label class="flex flex-col gap-1">
            <span class="text-xs text-neutral-500">{"Model"}</span>
            <select id="lr-model" onChange={onModel} class="rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/40">
              <option value="sonnet">{"sonnet"}</option>
              <option value="opus">{"opus"}</option>
              <option value="haiku">{"haiku"}</option>
            </select>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-xs text-neutral-500">{"Effort"}</span>
            <select id="lr-effort" onChange={onEffort} class="rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/40">
              <option value="">{"default"}</option>
              <option value="low">{"low"}</option>
              <option value="medium">{"medium"}</option>
              <option value="high">{"high"}</option>
            </select>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-xs text-neutral-500">{"Port"}<span class="text-neutral-600">{" (restart)"}</span></span>
            <input id="lr-port" type="number" min="1" max="65535" onChange={onPort} class="w-24 rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/40" />
          </label>
          <label class="flex min-w-0 flex-1 basis-full flex-col gap-1 sm:basis-auto">
            <span class="text-xs text-neutral-500">{"Anthropic base URL"}</span>
            <input id="lr-baseurl" type="text" placeholder="default" onChange={onBaseUrl} class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/40" />
          </label>
          <button onClick={() => login()} class="rounded-lg bg-brand-500 px-4 py-1.5 text-sm font-medium text-neutral-950 transition hover:bg-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500/50">{"Login"}</button>
        </div>
        <p class="mt-3 text-xs text-neutral-600">{"Start / Stop the core from the menu-bar tray. Port applies on restart; env vars win over these fields."}</p>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="mb-3 text-xs font-medium uppercase tracking-wide text-neutral-500">{"Usage"}</div>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-3 sm:gap-3">
            <div><div class="text-xs text-neutral-500">{"last hour"}</div><div id="u-1h" class="mt-1 text-xs tabular-nums text-neutral-200">{"…"}</div></div>
            <div><div class="text-xs text-neutral-500">{"last 24h"}</div><div id="u-24h" class="mt-1 text-xs tabular-nums text-neutral-200">{"…"}</div></div>
            <div><div class="text-xs text-neutral-500">{"last 7d"}</div><div id="u-7d" class="mt-1 text-xs tabular-nums text-neutral-200">{"…"}</div></div>
          </div>
          <div class="mt-4 mb-1 text-xs uppercase tracking-wide text-neutral-500">{"By client (7d)"}</div>
          <div class="overflow-x-auto">
          <table class="w-full min-w-[18rem] text-sm">
            <tbody>
              @for (const c of clients) {
                <tr class="border-b border-neutral-800/50">
                  <td class="py-1 pr-4 text-neutral-200">{c.client}</td>
                  <td class="py-1 pr-4 tabular-nums text-neutral-400">{c.requests}{" req"}</td>
                  <td class="py-1 pr-4 tabular-nums text-neutral-400">{c.completionTokens}{" tok"}</td>
                  <td class="py-1 tabular-nums text-emerald-400">{"$"}{c.costUsd.toFixed(4)}</td>
                </tr>
              }
            </tbody>
          </table>
          </div>
        </div>

        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="mb-3 text-xs font-medium uppercase tracking-wide text-neutral-500">{"Client tokens"}</div>
          <div class="flex flex-wrap items-center gap-2">
            <input id="tok-name" type="text" placeholder="client name (e.g. cognee)" class="rounded-lg border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm text-neutral-200 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500/40" />
            <button onClick={() => onCreateToken()} class="rounded-lg bg-brand-500 px-3 py-1.5 text-sm font-medium text-neutral-950 hover:bg-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500/50">{"Create token"}</button>
          </div>
          <div id="tok-new" class="mt-2 break-all font-mono text-xs text-emerald-400"></div>
          <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[18rem] text-sm">
            <tbody>
              @for (const t of tokens) {
                <tr class="border-b border-neutral-800/50">
                  <td class="py-1 pr-4 text-neutral-200">{t.name}</td>
                  <td class="py-1 pr-4 font-mono text-xs text-neutral-500 break-all">{t.token}</td>
                  <td class="py-1 text-right"><button onClick={() => onRevoke(t.token)} class="text-red-400 hover:text-red-300">{"revoke"}</button></td>
                </tr>
              }
            </tbody>
          </table>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,22rem)_1fr]">
        <div class="overflow-hidden rounded-xl border border-neutral-800 bg-neutral-900">
          <div class="border-b border-neutral-800 px-4 py-2.5 text-xs font-medium uppercase tracking-wide text-neutral-500">{"Requests"}</div>
          <div class="max-h-[32rem] overflow-auto">
            @for (const r of rows) {
              <button data-row={r.id} onClick={() => selectRow(r.id)} class="flex w-full items-center gap-2 border-b border-neutral-800/50 px-3 py-2 text-left transition hover:bg-neutral-800/40">
                <span class={"h-2 w-2 shrink-0 rounded-full " + phaseColor(r.phase, r.httpStatus)}></span>
                <span class="w-24 shrink-0 truncate font-mono text-xs text-neutral-400">{r.id}</span>
                <span class="w-16 shrink-0 truncate text-xs text-neutral-400">{r.client}</span>
                <span class="flex-1 truncate text-xs text-neutral-400">{rowLine(r)}</span>
              </button>
            }
          </div>
        </div>

        <div class="space-y-4 rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div id="d-head" class="text-sm font-semibold text-neutral-100">{"Select a request"}</div>
          <div id="d-meta" class="font-mono text-xs text-neutral-400"></div>
          <div>
            <div class="mb-1 text-xs uppercase tracking-wide text-neutral-500">{"Transitions"}</div>
            <pre id="d-timeline" class="whitespace-pre-wrap rounded-lg border border-neutral-800 bg-neutral-950 p-3 text-xs text-neutral-300"></pre>
          </div>
          <div>
            <div class="mb-1 text-xs uppercase tracking-wide text-neutral-500">{"Request"}</div>
            <pre id="d-req" class="max-h-64 overflow-auto whitespace-pre-wrap rounded-lg border border-neutral-800 bg-neutral-950 p-3 text-xs text-neutral-300"></pre>
          </div>
          <div>
            <div class="mb-1 text-xs uppercase tracking-wide text-neutral-500">{"Response"}</div>
            <pre id="d-res" class="max-h-64 overflow-auto whitespace-pre-wrap rounded-lg border border-neutral-800 bg-neutral-950 p-3 text-xs text-neutral-300"></pre>
          </div>
        </div>
      </div>

    </div>
  </div>
}
